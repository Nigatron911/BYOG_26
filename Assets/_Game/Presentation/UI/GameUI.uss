/* GameUI.uss - Styles for Game UI Toolkit */

.screen-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

/* TOP HUD CONTAINER */
.hud-top-container {
    position: absolute;
    top: 24px;
    align-self: center;
    align-items: center;
    pointer-events: none;
}

.stuck-warning-card {
    background-color: rgba(180, 30, 30, 0.92);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 100, 100, 0.9);
    padding: 10px 24px;
    align-items: center;
    justify-content: center;
    min-width: 320px;
    display: none;
    pointer-events: auto;
}

.stuck-timer-label {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.stuck-progress-track {
    width: 260px;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 3px;
    overflow: hidden;
}

.stuck-progress-fill {
    width: 0%;
    height: 100%;
    background-color: #ffd32a;
    border-radius: 3px;
}

.gravity-status-card {
    background-color: rgba(15, 23, 42, 0.92);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(56, 189, 248, 0.85);
    padding: 8px 22px;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
    min-width: 380px;
    display: none;
    pointer-events: auto;
}

.gravity-status-card-earth {
    border-color: rgba(34, 197, 94, 0.9);
    background-color: rgba(10, 35, 20, 0.94);
}

.gravity-status-card-roof {
    border-color: rgba(244, 63, 94, 0.9);
    background-color: rgba(40, 10, 20, 0.94);
}

.gravity-mode-label {
    color: #38bdf8;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}

.gravity-mode-label-earth {
    color: #4ade80;
}

.gravity-mode-label-roof {
    color: #f43f5e;
}

.gravity-timer-label {
    color: #cbd5e1;
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* BOTTOM TOOLBAR CONTAINER */
.toolbar-bottom-container {
    position: absolute;
    bottom: 24px;
    align-self: center;
    align-items: center;
    pointer-events: none;
}

.toolbar-dock {
    flex-direction: row;
    background-color: rgba(14, 18, 26, 0.94);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    padding: 10px 16px;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}

/* TOOL CARDS */
.tool-card {
    width: 100px;
    height: 80px;
    margin-left: 6px;
    margin-right: 6px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #d4a742;
    background-color: rgba(45, 34, 22, 0.92);
    align-items: center;
    justify-content: center;
    padding: 4px;
    transition: scale 0.1s, background-color 0.15s, border-color 0.15s;
}

.tool-card:hover {
    background-color: rgba(65, 50, 30, 0.98);
    border-color: #ffd700;
    scale: 1.05 1.05;
}

.tool-card:active {
    scale: 0.96 0.96;
}

.tool-card-disabled {
    opacity: 0.4;
}

.tool-card-keybadge {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 4px;
    padding: 1px 6px;
    margin-bottom: 4px;
}

.tool-card-keybadge-text {
    color: #e5b95c;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tool-card-title {
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tool-card-count {
    color: #ffd32a;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 1px;
}

/* ACTION BUTTONS */
.action-button {
    height: 60px;
    margin-left: 8px;
    margin-right: 8px;
    border-radius: 30px;
    border-width: 0;
    padding-left: 20px;
    padding-right: 20px;
    align-items: center;
    justify-content: center;
    transition: scale 0.1s, opacity 0.15s;
}

.action-button:hover {
    scale: 1.04 1.04;
}

.action-button:active {
    scale: 0.96 0.96;
}

.action-button-label {
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.btn-rotate {
    min-width: 125px;
    background-color: #c9881a;
}
.btn-rotate:hover {
    background-color: #e09b24;
}

.btn-simulate {
    min-width: 160px;
    background-color: #27ae60;
}
.btn-simulate:hover {
    background-color: #2ecc71;
}

.btn-simulate-active {
    background-color: #d63031;
}
.btn-simulate-active:hover {
    background-color: #e74c3c;
}

.btn-reset {
    min-width: 115px;
    background-color: #2980b9;
}
.btn-reset:hover {
    background-color: #3498db;
}

.btn-next {
    min-width: 125px;
    background-color: #8e44ad;
}
.btn-next:hover {
    background-color: #9b59b6;
}

/* TOP RIGHT CONTAINER */
.top-right-container {
    position: absolute;
    top: 20px;
    right: 24px;
    flex-direction: row;
    align-items: center;
}

.btn-next-top {
    min-width: 145px;
    height: 44px;
    padding: 8px 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
    background-color: #8e44ad;
}
.btn-next-top:hover {
    background-color: #9b59b6;
    border-color: rgba(255, 255, 255, 0.8);
    scale: 1.04 1.04;
}
.btn-next-top:active {
    background-color: #7d3c98;
    scale: 0.96 0.96;
}

/* GAME OVER OVERLAY */
.gameover-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 12, 18, 0.90);
    align-items: center;
    justify-content: center;
    display: none;
    pointer-events: auto;
}

.gameover-modal {
    width: 480px;
    background-color: rgba(22, 26, 36, 0.98);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(235, 60, 60, 0.7);
    padding: 36px 30px;
    align-items: center;
}

.gameover-title {
    color: #ff4757;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.gameover-cause {
    color: #dfe4ea;
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

.btn-retry {
    min-width: 260px;
    height: 56px;
    background-color: #2ed573;
    border-radius: 28px;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
    transition: scale 0.1s;
}

.btn-retry:hover {
    scale: 1.05 1.05;
    background-color: #26af5f;
}

.btn-retry:active {
    scale: 0.96 0.96;
}

.btn-retry-label {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* SCREEN FADER OVERLAY */
.screen-fader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
    opacity: 0;
    pointer-events: none;
}

/* MATERIAL STATUS PANEL (LEVEL 5) */
.material-status-card {
    background-color: rgba(14, 18, 28, 0.94);
    border-width: 2px;
    border-color: #38bdf8;
    border-radius: 8px;
    padding: 8px 16px;
    align-items: center;
    justify-content: center;
    min-width: 320px;
    margin-bottom: 6px;
}

.material-mode-label {
    color: #38bdf8;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.material-buttons-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    margin-bottom: 4px;
}

.mat-badge {
    padding: 3px 8px;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 5px;
    border-width: 1px;
    transition: scale 0.1s;
}

.mat-badge:hover {
    scale: 1.05 1.05;
}

.mat-badge:active {
    scale: 0.95 0.95;
}

.mat-badge-paper {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
}

.mat-badge-stone {
    background-color: rgba(100, 116, 139, 0.35);
    border-color: #94a3b8;
}

.mat-badge-rubber {
    background-color: rgba(16, 185, 129, 0.25);
    border-color: #10b981;
}

.mat-badge-active {
    border-width: 2px;
    border-color: #facc15;
}

.mat-badge-label {
    color: #f8fafc;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.material-switches-label {
    color: #94a3b8;
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* RULEBOOK BUTTON & MODAL */
.btn-rulebook {
    background-color: rgba(30, 41, 59, 0.9);
    border-color: rgba(234, 179, 8, 0.85);
    border-width: 2px;
    margin-right: 10px;
}

.btn-rulebook:hover {
    background-color: rgba(234, 179, 8, 0.25);
    border-color: #facc15;
    scale: 1.04 1.04;
}

.rulebook-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 15, 25, 0.82);
    align-items: center;
    justify-content: center;
    display: none;
    pointer-events: auto;
    z-index: 100;
}

.rulebook-modal {
    background-color: rgba(18, 22, 32, 0.96);
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(234, 179, 8, 0.65);
    padding: 16px 24px;
    align-items: center;
    width: 720px;
    max-height: 92%;
}

.rulebook-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    padding-bottom: 8px;
}

.rulebook-title {
    color: #facc15;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.btn-rulebook-close {
    width: 32px;
    height: 32px;
    background-color: rgba(239, 68, 68, 0.2);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(239, 68, 68, 0.6);
    align-items: center;
    justify-content: center;
}

.btn-rulebook-close:hover {
    background-color: rgba(239, 68, 68, 0.5);
    scale: 1.08 1.08;
}

.btn-close-label {
    color: #fca5a5;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.rulebook-body {
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    margin-bottom: 12px;
}

.rulebook-page-image {
    width: 580px;
    height: 620px;
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 8px;
}

.rulebook-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
}

.rulebook-nav-btn {
    min-width: 130px;
    height: 36px;
    background-color: rgba(51, 65, 85, 0.85);
    border-color: rgba(148, 163, 184, 0.6);
}

.rulebook-nav-btn:hover {
    background-color: rgba(100, 116, 139, 0.95);
    border-color: #cbd5e1;
    scale: 1.04 1.04;
}

.rulebook-page-indicator {
    color: #f8fafc;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
