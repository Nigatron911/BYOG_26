--- !u!114 &933848423
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 933848419}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1df79e392e7105e47b9389e729b25398, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Gameplay.LevelProgressionManager
  levels:
  - levelNumber: 1
    levelName: Level 1 - The Ascent
    spawnPosition: {x: -49, y: -1.8}
    cameraPosition: {x: -19.3, y: 6.7, z: -10}
    cameraOrthoSize: 19.57
    plankCount: 1
    ladderCount: 1
    platformCount: 1
    chainCount: 0
    toolLifetimeSeconds: 6.5
    goalShrine: {fileID: 627230548}
    cameraBounds:
      serializedVersion: 2
      x: -54
      y: -10.92347
      width: 69
      height: 36.546936
    followCamera: 0
    materialFormSeconds: 0
    briefingTitle: FADING INK
    briefingGoal: Help your character reach the exit door.
    briefingHowToPlay: The game starts paused. Drag planks, ladders and platforms
      from the toolbar into the level to build a safe path over the spikes and gaps.
      R rotates, right-click cancels.
    briefingCatch: When you press Simulate (or Space) your character walks on their
      own - you can't stop them. Every tool you placed vanishes 6.5 seconds after
      you hit Simulate, so build your path carefully.
  - levelNumber: 2
    levelName: Level 2 - Suspension Chasm
    spawnPosition: {x: 18.2, y: -1.4}
    cameraPosition: {x: 49.4, y: 3.5, z: -10}
    cameraOrthoSize: 22
    plankCount: 2
    ladderCount: 2
    platformCount: 2
    chainCount: 1
    toolLifetimeSeconds: 8
    goalShrine: {fileID: 1894879702}
    cameraBounds:
      serializedVersion: 2
      x: 13.200001
      y: -10.92347
      width: 75.2
      height: 36.546936
    followCamera: 0
    materialFormSeconds: 0
    briefingTitle: LOOSE THREADS
    briefingGoal: Cross the Suspension Chasm and reach the exit door.
    briefingHowToPlay: Same rules, more tools - and a chain. Pick the chain, then
      click where it starts and where it ends to hang it across a gap.
    briefingCatch: The chasm is wider and the spikes run longer. Your tools last
      8 seconds once the simulation starts - plan every second.
  - levelNumber: 3
    levelName: Level 3 - Gravity Inversion Chasm
    spawnPosition: {x: 91.4, y: -2.37665}
    cameraPosition: {x: 136.5, y: 10, z: -10}
    cameraOrthoSize: 31
    plankCount: 0
    ladderCount: 0
    platformCount: 0
    chainCount: 0
    toolLifetimeSeconds: 8
    goalShrine: {fileID: 899151270}
    cameraBounds:
      serializedVersion: 2
      x: 88.5
      y: -7.92347
      width: 98
      height: 33.54694
    followCamera: 1
    materialFormSeconds: 0
    briefingTitle: UPSIDE DOWN
    briefingGoal: Make it across the chasm to the exit door.
    briefingHowToPlay: You're in control now. A / D or the arrow keys to move, W
      or Space to jump.
    briefingCatch: Gravity won't sit still. Every few seconds it swaps between Earth
      and Moon - on the Moon you float, so a jump that's safe now can carry you into
      the spikes a moment later. Time it.
  - levelNumber: 4
    levelName: Level 4 - Chamber of Inversion
    spawnPosition: {x: 189.8, y: -1.6}
    cameraPosition: {x: 240, y: 10, z: -10}
    cameraOrthoSize: 31
    plankCount: 0
    ladderCount: 0
    platformCount: 0
    chainCount: 0
    toolLifetimeSeconds: 8
    goalShrine: {fileID: 0}
    cameraBounds:
      serializedVersion: 2
      x: 184.8
      y: -7.92347
      width: 109.40999
      height: 33.54694
    followCamera: 1
    materialFormSeconds: 0
    briefingTitle: THE CHAMBER
    briefingGoal: Open the chamber door and get through before it shuts.
    briefingHowToPlay: Step on the switch to raise the spikes, step off to bring
      out the platform, then touch the platform to open the door.
    briefingCatch: Gravity now changes at random - sometimes it flips you onto the
      ceiling with your controls reversed. The door only stays open for 4 seconds.
  - levelNumber: 5
    levelName: Level 5 - Material Alchemy
    spawnPosition: {x: 297.21, y: -0.7}
    cameraPosition: {x: 343.5, y: 7.5, z: -10}
    cameraOrthoSize: 31
    plankCount: 0
    ladderCount: 0
    platformCount: 0
    chainCount: 0
    toolLifetimeSeconds: 8
    goalShrine: {fileID: 960725679}
    cameraBounds:
      serializedVersion: 2
      x: 292.8
      y: -7.92347
      width: 101.70001
      height: 33.54694
    followCamera: 1
    materialFormSeconds: 6
    briefingTitle: PAPER, STONE, RUBBER
    briefingGoal: Reach the exit door.
    briefingHowToPlay: 'Change what you''re made of: 1 Paper, 2 Stone, 3 Rubber (Q
      / E to cycle). Paper is light and rides the wind. Stone is heavy, ignores wind
      and cracks glass floors. Rubber bounces higher with every landing.'
    briefingCatch: Only 5 changes per attempt, and Stone and Rubber fade back to
      Paper after 6 seconds - watch the bar over your head.
  - levelNumber: 6
    levelName: Level 6 - Aerial Material Traverse
    spawnPosition: {x: 400.6, y: 0.30000007}
    cameraPosition: {x: 466, y: 9.6, z: -10}
    cameraOrthoSize: 46
    plankCount: 0
    ladderCount: 0
    platformCount: 0
    chainCount: 0
    toolLifetimeSeconds: 8
    goalShrine: {fileID: 1298508640}
    cameraBounds:
      serializedVersion: 2
      x: 395.6
      y: -7.92347
      width: 141.6
      height: 33.54694
    followCamera: 1
    materialFormSeconds: 5
    briefingTitle: AERIAL TRAVERSE
    briefingGoal: Cross the open sky to the exit door.
    briefingHowToPlay: 1 Paper, 2 Stone, 3 Rubber (Q / E to cycle). Ride the wind
      as paper, drop through it as stone, bounce your way up as rubber.
    briefingCatch: Longer gaps, stronger winds, still only 5 changes - and every
      form now lasts just 5 seconds.
  - levelNumber: 7
    levelName: Level 7 - Inversion & Obscurity
    spawnPosition: {x: 543.3, y: -0.9}
    cameraPosition: {x: 600, y: 9.6, z: -10}
    cameraOrthoSize: 42
    plankCount: 0
    ladderCount: 0
    platformCount: 0
    chainCount: 0
    toolLifetimeSeconds: 8
    goalShrine: {fileID: 1686891748}
    cameraBounds:
      serializedVersion: 2
      x: 538.3
      y: -7.92347
      width: 120.77002
      height: 33.54694
    followCamera: 1
    materialFormSeconds: 0
    briefingTitle: REWRITE
    briefingGoal: Reach the exit door.
    briefingHowToPlay: 'Click an object to transmute it: walls become passable, spikes
      turn into trampolines and creatures become platforms you can stand on. Every
      click makes all changeable objects flash.'
    briefingCatch: Each change plunges the world into darkness for a moment, and
      only lasts 4 seconds before it snaps back.
  - levelNumber: 8
    levelName: Level 8 - Transmutation Trials
    spawnPosition: {x: 662.5, y: -2.8}
    cameraPosition: {x: 716, y: 8.5, z: -10}
    cameraOrthoSize: 42
    plankCount: 0
    ladderCount: 0
    platformCount: 0
    chainCount: 0
    toolLifetimeSeconds: 8
    goalShrine: {fileID: 576280305}
    cameraBounds:
      serializedVersion: 2
      x: 657.5
      y: -7.92347
      width: 117
      height: 33.54694
    followCamera: 1
    materialFormSeconds: 0
    briefingTitle: THE LAST PAGE
    briefingGoal: Survive the final trial and walk through the last door.
    briefingHowToPlay: 'Everything you''ve learned: transmute walls, spikes and creatures
      with a click and chain them together to climb.'
    briefingCatch: More creatures, tighter gaps, and every change still lasts only
      4 seconds. One wrong click and the path falls apart.
  player: {fileID: 376802629}
  worldCamera: {fileID: 1231627502}
